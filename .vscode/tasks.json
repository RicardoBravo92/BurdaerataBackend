{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: uvicorn (reload)",
      "type": "shell",
      "command": "uv run python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "backend: pytest",
      "type": "shell",
      "command": "uv run python -m pytest",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "backend: alembic upgrade",
      "type": "shell",
      "command": "uv run python -m alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
